/*pages/category/category 分类页*/
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.layout {
  flex: 1;
  display: flex;
  overflow: hidden;
  min-height: 0;
}

/* 左侧分类栏 */
.side {
  width: 180rpx;
  height: 100%;
  background: #efeff2;
  flex-shrink: 0;
}
.side-item {
  position: relative;
  padding: 34rpx 12rpx;
  text-align: center;
  color: #666;
  font-size: 28rpx;
}
.side-item.active {
  background: #ffffff;
  color: #ee5a24;
  font-weight: 600;
}
.side-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  border-radius: 3rpx;
  background: #ee5a24;
}
.side-count {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #aaaaaa;
}
.side-item.active .side-count {
  color: #ee5a24;
}

/* 右侧菜品区 */
.main {
  flex: 1;
  height: 100%;
}
/* 与「全部」页一致的网格：先横排，每行两张，再换行竖排 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 24rpx 48rpx;
}
.grid-item {
  width: 339rpx;
  margin-right: 24rpx;
  margin-bottom: 24rpx;
}
.grid-item:nth-child(even) {
  margin-right: 0;
}
recipe-card {
  display: block;
}
