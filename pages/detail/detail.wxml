<!--pages/detail/detail 菜品详情-->
<view class="page" wx:if="{{recipe}}">
  <!-- 大图封面（点击可全屏预览） -->
  <image
    class="hero"
    src="{{recipe.coverImageFileID}}"
    mode="aspectFill"
    bind:tap="previewCover"
  />

  <!-- 标题信息 -->
  <view class="panel head-panel">
    <view class="head-row">
      <view class="name">{{recipe.name}}</view>
      <view
        class="fav-btn {{recipe.isFavorite ? 'on' : ''}}"
        bind:tap="onToggleFav"
      >
        <text class="fav-star">★</text>
        <text class="fav-text">{{recipe.isFavorite ? '已收藏' : '收藏'}}</text>
      </view>
    </view>
    <view class="head-meta">
      <text class="tag">{{recipe.category}}</text>
      <text class="date" wx:if="{{createdAtText}}">记录于 {{createdAtText}}</text>
    </view>
  </view>

  <!-- 配方 -->
  <view class="panel">
    <view class="panel-title">配方</view>
    <text class="content" user-select="{{true}}">{{recipe.recipeContent}}</text>
  </view>

  <!-- 备注 -->
  <view class="panel" wx:if="{{recipe.note}}">
    <view class="panel-title">备注 / 心得</view>
    <text class="content" user-select="{{true}}">{{recipe.note}}</text>
  </view>

  <!-- 底部操作 -->
  <view class="footer">
    <button class="btn-ghost edit-btn" bind:tap="onEdit">编辑</button>
    <button class="btn-danger" bind:tap="onDelete">删除</button>
  </view>
</view>

<view wx:elif="{{!loading}}" class="empty">
  <text class="empty-icon">😕</text>
  <view class="empty-text">菜品不存在或已被删除</view>
</view>
