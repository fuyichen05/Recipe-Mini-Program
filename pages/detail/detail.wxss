/*pages/detail/detail 菜品详情*/
.page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.hero {
  display: block;
  width: 100%;
  height: 480rpx;
  background: #eeeeee;
}

.panel {
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 28rpx;
}
.head-panel {
  margin-top: -60rpx;
  position: relative;
}

.head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #222222;
}
.fav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 16rpx;
  flex-shrink: 0;
}
.fav-star {
  font-size: 44rpx;
  color: #d8d8d8;
  line-height: 1;
}
.fav-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}
.fav-btn.on .fav-star,
.fav-btn.on .fav-text {
  color: #ffb800;
}

.head-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.date {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #aaaaaa;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
  margin-bottom: 16rpx;
}
.content {
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333333;
  white-space: pre-wrap;
  word-break: break-all;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(246, 246, 248, 0.96);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.edit-btn {
  flex: 1;
  margin-right: 20rpx;
}
.btn-danger {
  flex: 1;
  background: #ffffff;
  color: #e53935;
  border-radius: 999rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.btn-danger::after {
  border: none;
}
