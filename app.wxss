/*app.wxss —— 全局样式*/
page {
  background: #F6F6F8;
  font-size: 28rpx;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 通用空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
}
.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  color: #999;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.7;
}

/* 分类小标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(238, 90, 36, 0.1);
  color: #EE5A24;
  font-size: 22rpx;
}

/* 通用按钮 */
.btn-primary {
  background: #EE5A24;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.btn-primary::after {
  border: none;
}
.btn-primary.disabled {
  opacity: 0.6;
}
.btn-ghost {
  background: #fff;
  color: #666;
  border-radius: 999rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.btn-ghost::after {
  border: none;
}
