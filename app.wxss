/*app.wxss —— 全局样式*/
page {
  background: #F6F6F8;
  font-size: 28rpx;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 通用空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
}
.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  color: #999;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.7;
}

/* 分类小标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(238, 90, 36, 0.1);
  color: #EE5A24;
  font-size: 22rpx;
}

/* 通用按钮（内置小图标时自动居中对齐） */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff7a3c 0%, #ee5a24 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  height: 88rpx;
  box-shadow: 0 10rpx 24rpx rgba(238, 90, 36, 0.25);
}
.btn-primary::after {
  border: none;
}
.btn-primary.disabled {
  opacity: 0.6;
}
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #666;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  height: 88rpx;
}
.btn-ghost::after {
  border: none;
}
/* 按钮内小图标 */
.btn-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
}
